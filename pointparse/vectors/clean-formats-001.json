{
  "id": "clean-formats-001",
  "title": "十种干净格式",
  "why": "回归基线。这些是规范推荐模型输出的形态，必须全部一次命中。",
  "cases": [
    {
      "in": {
        "x": 400,
        "y": 900
      },
      "out": [
        "ok",
        400.0,
        900.0,
        "dict_xy"
      ]
    },
    {
      "in": {
        "point": [
          400,
          900
        ]
      },
      "out": [
        "ok",
        400.0,
        900.0,
        "dict_point"
      ]
    },
    {
      "in": {
        "coordinate": [
          400,
          900
        ]
      },
      "out": [
        "ok",
        400.0,
        900.0,
        "dict_point"
      ]
    },
    {
      "in": [
        400,
        900
      ],
      "out": [
        "ok",
        400.0,
        900.0,
        "sequence"
      ]
    },
    {
      "in": [
        400,
        900
      ],
      "out": [
        "ok",
        400.0,
        900.0,
        "sequence"
      ]
    },
    {
      "in": "(400, 900)",
      "out": [
        "ok",
        400.0,
        900.0,
        "paren_csv"
      ]
    },
    {
      "in": "400, 900",
      "out": [
        "ok",
        400.0,
        900.0,
        "bare_csv"
      ]
    },
    {
      "in": "x=400, y=900",
      "out": [
        "ok",
        400.0,
        900.0,
        "kv"
      ]
    },
    {
      "in": "<point>400 900</point>",
      "out": [
        "ok",
        400.0,
        900.0,
        "bare_csv"
      ]
    },
    {
      "in": "{\"x\": 400, \"y\": 900}",
      "out": [
        "ok",
        400.0,
        900.0,
        "dict_xy"
      ]
    }
  ]
}
