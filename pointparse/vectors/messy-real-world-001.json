{
  "id": "messy-real-world-001",
  "title": "真实脏数据",
  "why": "模型不会按你的 schema 输出。这些形状在生产中全都出现过。",
  "cases": [
    {
      "in": "(0.42, 0.38)",
      "out": [
        "ok",
        0.42,
        0.38,
        "paren_csv"
      ]
    },
    {
      "in": "(-5, 120)",
      "out": [
        "ok",
        -5.0,
        120.0,
        "paren_csv"
      ]
    },
    {
      "in": "400；900",
      "out": [
        "ok",
        400.0,
        900.0,
        "bare_csv"
      ]
    },
    {
      "in": "I'll tap at (400, 900) now.",
      "out": [
        "ok",
        400.0,
        900.0,
        "paren_csv"
      ]
    },
    {
      "in": "```json\n{\"x\": 400, \"y\": 900}\n```",
      "out": [
        "ok",
        400.0,
        900.0,
        "dict_xy"
      ]
    },
    {
      "in": "x = 400 , y = 900",
      "out": [
        "ok",
        400.0,
        900.0,
        "kv"
      ]
    },
    {
      "in": "[12.5, 34.75]",
      "out": [
        "ok",
        12.5,
        34.75,
        "sequence"
      ]
    },
    {
      "in": "1,400, 900",
      "out": [
        "ambig"
      ]
    }
  ]
}
