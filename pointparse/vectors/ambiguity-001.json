{
  "id": "ambiguity-001",
  "title": "必须报歧义，不许猜",
  "why": "这些输入的'正确答案'取决于语义决策。解析器替调用方选一个，就是把 bug 藏起来。",
  "cases": [
    {
      "in": "First tap (100, 200), then tap (300, 400).",
      "out": [
        "ambig"
      ]
    },
    {
      "in": [
        100,
        200,
        300,
        400
      ],
      "out": [
        "ambig"
      ]
    },
    {
      "in": {
        "bbox": [
          100,
          200,
          300,
          400
        ]
      },
      "out": [
        "ambig"
      ]
    },
    {
      "in": {
        "box": [
          10,
          20,
          30,
          40
        ]
      },
      "out": [
        "ambig"
      ]
    },
    {
      "in": [
        100,
        200,
        300
      ],
      "out": [
        "nopoint"
      ]
    },
    {
      "in": "tap (400,900) and then tap (400,900) again",
      "out": [
        "ok",
        400.0,
        900.0,
        "paren_csv"
      ]
    }
  ]
}
